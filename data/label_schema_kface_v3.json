  "limitations": [
    "경계값은 이 코호트의 상대 위치(하위·중간·상위 1/3)이며 해부학 표준이나 관상 표준이 아니다.",
    "K-FACE 촬영 참여자의 연령·성별 구성이 한국인 전체를 대표한다는 근거는 확인하지 않았다.",
    "깊이는 직교 투영 근사와 MediaPipe 랜드마크 위치에 의존하는 상대값이다. mm 단위가 아니다.",
    "눈 개방·입꼬리·눈썹 위치는 촬영 순간의 표정 근육 상태를 포함한다."
  ],
  "withheld_features": {
    "brow_glabella": {
      "ko": "미간 털·일자로 이어진 눈썹",
      "reason": "400명 검수에서 미간 털이 뚜렷한 사례가 없어 학습 불가(전원 깨끗함)"
    },
    "nose_dorsum": {
      "ko": "옆에서 본 콧대 모양(곧음/솟음/꺼짐)",
      "reason": "40° 사선으로는 콧대 윤곽이 보이지 않음. 90° 측면(C1/C13)은 랜드마크 검출 실패"
    },
    "under_eye": {
      "ko": "애교살(와잠)",
      "reason": "400명 중 뚜렷한 사례 8명으로 학습 불가"
    },
    "philtrum_definition": {
      "ko": "인중 골의 뚜렷함",
      "reason": "독립 판정자 3명 일치도 Fleiss κ 0.173 (우연 수준에 가까움). 조명·수염 그늘에 판정이 흔들림"
    }
  },
  "reliability_notes": {
    "eye_asymmetry": "조명 반복 ICC 0.53. 서비스에서는 확신 구간에서만 언급",
