{
  "name": "faceteller-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:release": "playwright test --config playwright.release.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "@mediapipe/tasks-vision": "0.10.32",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
